# SDI Same Day Intelligence - copy this file to C:\SDI_Automation\.env on the server and fill in the values.
# NEVER put the real .env on K: or any shared drive - anyone who can read it can spend the credits.

# --- AI keys (required) ---
OPENAI_API_KEY=          # images (gpt-image-2) + live voice (gpt-realtime) + transcribe + voice-note replies
ANTHROPIC_API_KEY=       # chat (Claude Sonnet 5.5 / Haiku 5.5), moodboard web search, design director
XAI_API_KEY=             # optional: Grok images as a backup when OpenAI images fail

# --- Who can open it from outside the server (phone app / HTTPS link) ---
LITE_ACCESS_CODE=        # a team code asked once on phones; on the server itself no code is asked
# LITE_TRUST_FROM=       # the App Proxy connector's IP(s): people coming through SDI sign-in skip the team code

# --- Models (defaults shown; leave out to keep them) ---
LITE_RT_MODEL=gpt-realtime
# LITE_RT_VOICE=cedar                       # the live call's voice
# LITE_RT_TRANSCRIBE=gpt-4o-transcribe
# LITE_CHAT_MODEL=claude-sonnet-5-5
# LITE_IMAGE_MODEL=gpt-image-2
# LITE_IMAGE_QUALITY=high                   # first concept
# LITE_CHANGE_QUALITY=medium                # changes and fixes
# LITE_DIRECTOR_MODEL=claude-opus-5-5       # writes the design idea before each render
# LITE_STT_MODEL=gpt-4o-transcribe          # hears voice notes (free Whisper if it fails)
# LITE_TTS_MODEL=gpt-4o-mini-tts            # voice-note replies (free Microsoft voice if it fails)
# LITE_TTS_VOICE=fable
# BRIEF_LITE_PORT=5020
# CRAFT_PORT=5030

# --- WhatsApp (optional - only if the WhatsApp Business line is used) ---
# WA_ACCESS_TOKEN=
# WA_PHONE_ID=
# WA_VERIFY_TOKEN=
# WA_APP_SECRET=
# WA_ALLOWED=              # comma-separated staff numbers allowed to use it

# --- Cloudflare (optional - only for the phone HTTPS link via a named tunnel) ---
# CF_API_TOKEN=
